# Multiplayer on Vercel: connect Upstash Redis through the Vercel Marketplace.
# Server-only credentials. NEVER use the VITE_ prefix for these values.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional namespace override. Use different values for separate projects/envs.
# ROOM_KEY_PREFIX=money-money-lhamas:development

# The KV_REST_API_URL / KV_REST_API_TOKEN pair is also supported when provided
# by the integration. Configure one complete pair; a read-only token cannot work.
# Local dev/preview/serve use memory when neither pair is set.
