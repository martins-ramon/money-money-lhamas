entrypoint = "index.html"
modules = ["nodejs-20", "bash", "web"]
run = "npm ci --include=dev && npm run dev"

[[ports]]
localPort = 5174
externalPort = 80

[deployment]
deploymentTarget = "static"
build = ["sh", "-c", "npm ci --include=dev && npm run build"]
publicDir = "dist"

[nix]
channel = "stable-25_05"
